{
  "name": "aidan-al-haberi",
  "version": "1.0.2",
  "description": "AI'dan Al Haberi — a desktop AI & software research agent that scans the people and topics you follow and publishes Turkish analyses as a vintage newspaper.",
  "main": "./out/main/index.js",
  "author": {
    "name": "Abdurrahman Uçak",
    "email": "abdurrahmanucak00@gmail.com"
  },
  "license": "MIT",
  "private": false,
  "homepage": "https://github.com/abdurrahmanucak00/aidan-al-haberi#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abdurrahmanucak00/aidan-al-haberi.git"
  },
  "bugs": {
    "url": "https://github.com/abdurrahmanucak00/aidan-al-haberi/issues"
  },
  "keywords": [
    "electron",
    "react",
    "typescript",
    "ai",
    "gemini",
    "tavily",
    "research-agent",
    "news-aggregator",
    "desktop-app",
    "tailwindcss"
  ],
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "node --test tests/*.test.cjs",
    "screenshots": "npm run build && electron scripts/capture-screenshots.cjs",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux",
    "cap:sync": "npm run build && npx cap sync android",
    "cap:open": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/status-bar": "^8.0.3",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@google/generative-ai": "^0.24.1",
    "@supabase/supabase-js": "^2.112.4",
    "@tailwindcss/vite": "^4.3.3",
    "clsx": "^2.1.1",
    "electron-updater": "^6.3.9",
    "framer-motion": "^13.1.1",
    "lucide-react": "^1.34.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.5.4",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "png-to-ico": "^3.0.2",
    "postcss": "^8.5.26",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.2.6"
  }
}
