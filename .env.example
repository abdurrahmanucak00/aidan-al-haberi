# AI'dan Al Haberi — environment variables
#
# Copy to `.env` and fill in your own values:  cp .env.example .env
# `.env` is gitignored and must never be committed.
#
# Tavily and Gemini API keys are NOT read from here. Enter them in the app's
# Settings tab, where they are encrypted before being stored on your device.

# --- Optional: Supabase cloud sync -------------------------------------------
# Leave these empty to run fully local-first. If you set them, apply
# `supabase-schema.sql` in the Supabase SQL editor first.
# The anon key is a PUBLIC client credential; access is enforced by the
# row-level security policies, not by keeping this key secret.
# NEVER put a service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Optional: local credential encryption key --------------------------------
# Used to derive the AES-256-GCM key that protects stored API keys.
# If unset, a fixed, publicly known development secret is used, which only
# obfuscates local storage. Set a long random value for anything beyond personal
# use:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Note: packaged builds do not read a `.env` file, so set this as a real
# environment variable on the system that runs the app.
ENCRYPTION_KEY=
